    {
      "if": {
        "properties": {
          "experiment": {
            "properties": {
              "arm": {
                "const": "hybrid_targets"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "arms": {
            "properties": {
              "hybrid_targets": {
