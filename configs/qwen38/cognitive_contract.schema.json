              },
              "parent_contract_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "measurement_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "arms": {
            "properties": {
              "frontier_sampling": {
